[Unit]
Description=Fetch public freesub Gateway candidate feed
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=aimili-gateway
Group=aimili-gateway
ExecStart=/usr/local/libexec/aimili-freesub-feed
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/aimili-gateway/freesub
RestrictAddressFamilies=AF_INET AF_INET6
