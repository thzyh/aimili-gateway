diff --git a/internal/web/service/client_alias.go b/internal/web/service/client_alias.go
new file mode 100644
index 0000000..51e06c6
--- /dev/null
+++ b/internal/web/service/client_alias.go
@@ -0,0 +1,64 @@
+package service
+
+import (
+	"errors"
+	"strings"
+	"unicode"
+	"unicode/utf8"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+	"gorm.io/gorm"
+)
+
+// GetInboundAliases returns the overrides belonging to one client association.
+func (s *ClientService) GetInboundAliases(email string) (map[int]string, error) {
+	record, err := s.GetRecordByEmail(nil, email)
+	if err != nil {
+		return nil, err
+	}
+	var links []model.ClientInbound
+	if err := database.GetDB().Where("client_id = ?", record.Id).Find(&links).Error; err != nil {
+		return nil, err
+	}
+	aliases := make(map[int]string, len(links))
+	for _, link := range links {
+		aliases[link.InboundId] = link.AliasOverride
+	}
+	return aliases, nil
+}
+
+// SetInboundAliases updates only existing associations of the selected client.
+func (s *ClientService) SetInboundAliases(email string, aliases map[int]string) error {
+	if len(aliases) == 0 {
+		return errors.New("aliases are required")
+	}
+	for id, alias := range aliases {
+		if id <= 0 || utf8.RuneCountInString(alias) > 96 || strings.TrimSpace(alias) != alias || strings.IndexFunc(alias, unicode.IsControl) >= 0 {
+			return errors.New("invalid inbound alias")
+		}
+	}
+	record, err := s.GetRecordByEmail(nil, email)
+	if err != nil {
+		return err
+	}
+	return database.GetDB().Transaction(func(tx *gorm.DB) error {
+		var links []model.ClientInbound
+		if err := tx.Where("client_id = ?", record.Id).Find(&links).Error; err != nil {
+			return err
+		}
+		if len(links) != len(aliases) {
+			return errors.New("inbound associations changed")
+		}
+		for _, link := range links {
+			alias, ok := aliases[link.InboundId]
+			if !ok {
+				return errors.New("unknown inbound association")
+			}
+			if err := tx.Model(&model.ClientInbound{}).Where("client_id = ? AND inbound_id = ?", record.Id, link.InboundId).Update("alias_override", alias).Error; err != nil {
+				return err
+			}
+		}
+		return nil
+	})
+}
