@@ -0,0 +1,44 @@
+package service
+
+import (
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+)
+
+func TestInboundAliasesAreScopedToTheClientAndExistingLinks(t *testing.T) {
+	setupConflictDB(t)
+	db := database.GetDB()
+	first := model.ClientRecord{Email: "gateway@example.test", SubID: "gateway-sub"}
+	second := model.ClientRecord{Email: "other@example.test", SubID: "other-sub"}
+	if err := db.Create(&first).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&second).Error; err != nil {
+		t.Fatal(err)
+	}
+	for _, link := range []model.ClientInbound{{ClientId: first.Id, InboundId: 1}, {ClientId: second.Id, InboundId: 1}} {
+		if err := db.Create(&link).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	svc := &ClientService{}
+	if err := svc.SetInboundAliases(first.Email, map[int]string{1: "主连接_日本"}); err != nil {
+		t.Fatal(err)
+	}
+	firstAliases, err := svc.GetInboundAliases(first.Email)
+	if err != nil || firstAliases[1] != "主连接_日本" {
+		t.Fatalf("first aliases=%v err=%v", firstAliases, err)
+	}
+	otherAliases, err := svc.GetInboundAliases(second.Email)
+	if err != nil || otherAliases[1] != "" {
+		t.Fatalf("other aliases=%v err=%v", otherAliases, err)
+	}
+	if err := svc.SetInboundAliases(first.Email, map[int]string{2: "unknown"}); err == nil {
+		t.Fatal("unattached inbound accepted")
+	}
+	if err := svc.SetInboundAliases(first.Email, map[int]string{1: "bad\nname"}); err == nil {
+		t.Fatal("control character accepted")
+	}
+}
