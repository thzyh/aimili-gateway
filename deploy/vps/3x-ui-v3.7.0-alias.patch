+package sub
+
+import (
+	"path/filepath"
+	"testing"
+
+	"github.com/mhsanaei/3x-ui/v3/internal/database"
+	"github.com/mhsanaei/3x-ui/v3/internal/database/model"
+)
+
+func TestSubscriptionInboundRemarkUsesOnlyItsClientAlias(t *testing.T) {
+	if err := database.InitDB(filepath.Join(t.TempDir(), "x-ui.db")); err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { _ = database.CloseDB() })
+	db := database.GetDB()
+	inbound := model.Inbound{Tag: "agw-main", Remark: "original", Protocol: model.VLESS, Port: 8443, Enable: true}
+	if err := db.Create(&inbound).Error; err != nil {
+		t.Fatal(err)
+	}
+	first := model.ClientRecord{Email: "gateway@example.test", SubID: "gateway-sub"}
+	second := model.ClientRecord{Email: "other@example.test", SubID: "other-sub"}
+	if err := db.Create(&first).Error; err != nil {
+		t.Fatal(err)
+	}
+	if err := db.Create(&second).Error; err != nil {
+		t.Fatal(err)
+	}
+	for _, link := range []model.ClientInbound{{ClientId: first.Id, InboundId: inbound.Id, AliasOverride: "主连接_日本"}, {ClientId: second.Id, InboundId: inbound.Id}} {
+		if err := db.Create(&link).Error; err != nil {
+			t.Fatal(err)
+		}
+	}
+	svc := NewSubService("")
+	for _, test := range []struct{ subID, want string }{{"gateway-sub", "主连接_日本"}, {"other-sub", "original"}} {
+		rows, err := svc.getInboundsBySubId(test.subID)
+		if err != nil || len(rows) != 1 || rows[0].Remark != test.want {
+			t.Fatalf("sub=%s rows=%v err=%v", test.subID, rows, err)
+		}
+	}
+}
