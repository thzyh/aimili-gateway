 	if err != nil {
 		return nil, err
 	}
+	var aliasRows []struct {
+		InboundId     int
+		AliasOverride string
+	}
+	if err := db.Table("client_inbounds").
+		Select("client_inbounds.inbound_id, client_inbounds.alias_override").
+		Joins("JOIN clients ON clients.id = client_inbounds.client_id").
+		Where("clients.sub_id = ? AND client_inbounds.alias_override <> ''", subId).
