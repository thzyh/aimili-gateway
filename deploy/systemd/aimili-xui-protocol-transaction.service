[Unit]
Description=Apply one bounded Aimili Xray protocol transaction batch
After=x-ui.service

[Service]
Type=oneshot
User=root
Group=aimili-gateway
ExecStart=/usr/local/bin/aimili-xui-protocol-transaction --config /etc/aimili-gateway/protocol-transaction.json spool
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectClock=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=CAP_DAC_OVERRIDE
AmbientCapabilities=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
ReadWritePaths=/etc/x-ui
ReadWritePaths=/var/lib/aimili-gateway/protocol-spool/requests
ReadWritePaths=/var/lib/aimili-gateway/protocol-spool/results
ReadWritePaths=/var/lib/aimili-xui-protocol-transaction
