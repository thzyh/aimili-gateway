#!/usr/bin/env bash
set -euo pipefail

if (( $# != 0 )); then
    printf '用法：sudo aimili-gateway-account\n' >&2
    exit 2
fi
if (( EUID != 0 )); then
    printf '请执行 sudo aimili-gateway-account。\n' >&2
    exit 1
fi

unit_name="aimili-gateway-account-$(date +%s)-$$"
credential_directory="/run/credentials/${unit_name}.service"

if /usr/bin/systemd-run \
    --quiet \
    --wait \
    --collect \
    --pty \
    --service-type=exec \
    --unit="$unit_name" \
    --property=User=aimili-gateway \
    --property=Group=aimili-gateway \
    --property=WorkingDirectory=/var/lib/aimili-gateway \
    --property=LoadCredentialEncrypted=gateway-master-key:/etc/credstore.encrypted/aimili-gateway-master-key \
    --property=LoadCredential=aimili-control-token:/etc/aimilivpn/control.token \
    --property=LoadCredential=xui-automation:/etc/aimili-gateway/xui-automation.json \
    --setenv=GATEWAY_CONFIG=/etc/aimili-gateway/config.json \
    --setenv=GATEWAY_MASTER_KEY_FILE="$credential_directory/gateway-master-key" \
    --setenv=GATEWAY_AIMILI_CONTROL_TOKEN_FILE="$credential_directory/aimili-control-token" \
    --setenv=GATEWAY_XUI_CREDENTIALS_FILE="$credential_directory/xui-automation" \
    --property=UMask=0077 \
    --property=NoNewPrivileges=yes \
    --property=PrivateTmp=yes \
    --property=PrivateDevices=yes \
    --property=ProtectSystem=strict \
    --property=ProtectHome=yes \
    --property=ReadWritePaths=/var/lib/aimili-gateway \
    --property=ProtectControlGroups=yes \
    --property=ProtectKernelLogs=yes \
    --property=ProtectKernelModules=yes \
    --property=ProtectKernelTunables=yes \
    --property=ProtectProc=invisible \
    --property=ProcSubset=pid \
    --property=RestrictNamespaces=yes \
    --property=RestrictRealtime=yes \
    --property=RestrictSUIDSGID=yes \
    --property=LockPersonality=yes \
    --property=MemoryDenyWriteExecute=yes \
    --property=CapabilityBoundingSet= \
    --property="RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6" \
    --property=IPAddressDeny=any \
    --property=IPAddressAllow=localhost \
    /usr/local/bin/aimili-gateway-admin account
then
    /usr/bin/systemctl try-restart aimili-gateway.service
else
    exit $?
fi
